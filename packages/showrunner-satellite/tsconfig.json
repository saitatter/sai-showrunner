			// "showrunner-plugin-os-renderer": ["../../plugins/os/renderer/src/main.ts"],
			// "showrunner-plugin-sound-renderer": ["../../plugins/sound/renderer/src/main.ts"],
			// "showrunner-plugin-random-renderer": ["../../plugins/random/renderer/src/main.ts"],
			// "showrunner-plugin-remote-renderer": ["../../plugins/remote/renderer/src/main.ts"],

			// "showrunner-plugin-voicemod-renderer": ["../../plugins/voicemod/renderer/src/main.ts"],
			// "showrunner-plugin-twinkly-renderer": ["../../plugins/twinkly/renderer/src/main.ts"],
			// "showrunner-plugin-philips-hue-renderer": ["../../plugins/philips-hue/renderer/src/main.ts"],
