			"showrunner-ui-core": ["../../libs/showrunner-ui-core/src/main.ts"],
			// "showrunner-overlay-widget-loader": [
			// 	"../../libs/showrunner-overlay-widget-loader/src/overlay-widget-loader.ts"
			// ],
			"showrunner-overlay-core": ["../../libs/showrunner-overlay-core/src/overlay-core-main.ts"],
			"showrunner-plugin-twitch-renderer": ["../../plugins/twitch/renderer/src/main.ts"],
			"showrunner-dashboard-core": ["../../libs/showrunner-dashboard-core/src/dashboard-core-main.ts"],
			"showrunner-dashboard-widget-loader": [
				"../../libs/showrunner-dashboard-widget-loader/src/dashboard-widget-loader.ts"
			],
			"showrunner-plugin-sound-renderer": ["../../plugins/sound/renderer/src/main.ts"],
			"showrunner-plugin-iot-renderer": ["../../plugins/iot/renderer/src/main.ts"],
			"showrunner-plugin-tplink-kasa-renderer": ["../../plugins/tplink-kasa/renderer/src/main.ts"],
			"showrunner-plugin-lifx-renderer": ["../../plugins/lifx/renderer/src/main.ts"],
			"showrunner-plugin-philips-hue-renderer": ["../../plugins/philips-hue/renderer/src/main.ts"],
			"showrunner-plugin-govee-renderer": ["../../plugins/govee/renderer/src/main.ts"],
			"showrunner-plugin-wyze-renderer": ["../../plugins/wyze/renderer/src/main.ts"],
			"showrunner-plugin-twinkly-renderer": ["../../plugins/twinkly/renderer/src/main.ts"]

			//TODO: "showrunner-plugin-*-renderer": ["../../plugins/*/renderer/src/main.ts"]
			// "showrunner-plugin-discord-renderer": ["../../plugins/discord/renderer/src/main.ts"],
			// "showrunner-plugin-input-renderer": ["../../plugins/input/renderer/src/main.ts"],
