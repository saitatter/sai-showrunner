{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "paths": {
      "showrunner-overlay-core": ["../../../libs/showrunner-overlay-core/src/overlay-core-main.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
