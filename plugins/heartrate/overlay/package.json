{
  "name": "showrunner-plugin-heartrate-overlays",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "src/main.ts",
  "devMain": "src/main.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "showrunner": {
    "pluginId": "heartrate",
    "overlay": {
      "entry": "./src/main.ts",
      "widgets": [
        {
          "id": "heartRate",
          "name": "Heart Rate",
          "description": "Displays the live Heart Rate state from ShowRunner.",
          "icon": "mdi mdi-heart-pulse",
          "defaultSize": {
            "width": 260,
            "height": 110
          },
          "capabilities": {
            "states": [
              "heartRate",
              "connection",
              "device"
            ],
            "resizable": true
          },
          "config": {
            "showLabel": {
              "type": "boolean",
              "default": true
            },
            "accentColor": {
              "type": "string",
              "default": "#f43f5e"
            },
            "animate": {
              "type": "boolean",
              "default": true
            },
            "showBattery": {
              "type": "boolean",
              "default": false
            },
            "showConnection": {
              "type": "boolean",
              "default": true
            }
          }
        },
        {
          "id": "heartRateZone",
          "name": "Heart Rate Zone",
          "description": "Displays the current heart-rate training zone.",
          "icon": "mdi mdi-heart-pulse",
          "defaultSize": {
            "width": 280,
            "height": 90
          },
          "capabilities": {
            "states": [
              "zone",
              "connection"
            ],
            "resizable": true
          },
          "config": {
            "showLabel": {
              "type": "boolean",
              "default": true
            },
            "accentColor": {
              "type": "string",
              "default": "#f43f5e"
            }
          }
        },
        {
          "id": "heartRateGraph",
          "name": "Heart Rate Graph",
          "description": "Displays a live, bounded heart-rate history.",
          "icon": "mdi mdi-chart-line",
          "defaultSize": {
            "width": 420,
            "height": 180
          },
          "capabilities": {
            "states": [
              "heartRate",
              "connection"
            ],
            "resizable": true
          },
          "config": {
            "showLabel": {
              "type": "boolean",
              "default": true
            },
            "accentColor": {
              "type": "string",
              "default": "#f43f5e"
            },
            "maxBpm": {
              "type": "number",
              "default": 200
            },
            "showConnection": {
              "type": "boolean",
              "default": true
            }
          }
        }
      ]
    }
  },
  "dependencies": {
    "showrunner-overlay-core": "workspace:^"
  },
  "devDependencies": {
    "typescript": "*"
  }
}
