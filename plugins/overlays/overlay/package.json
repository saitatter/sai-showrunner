								"fontColor": { "type": "color", "name": "Font Color", "default": "#FFFFFF" },
								"stroke": {
									"type": "object",
									"name": "Stroke",
									"default": { "width": 4, "color": "#000000" },
									"fields": {
										"width": { "type": "number", "name": "Width", "default": 4 },
										"color": { "type": "color", "name": "Stroke Color", "default": "#000000" }
									}
								},
								"shadow": {
									"type": "object",
									"name": "Shadow",
									"fields": {
										"blur": { "type": "number", "name": "Blur", "default": 4 },
										"color": { "type": "color", "name": "Shadow Color", "default": "#FFFFFF" },
										"offsetX": { "type": "number", "name": "Offset X", "default": 0 },
										"offsetY": { "type": "number", "name": "Offset Y", "default": 0 }
									}
								}
							}
						},
						"textAlign": {
							"type": "object",
							"editor": "overlayTextAlignment",
							"name": "Text Align",
