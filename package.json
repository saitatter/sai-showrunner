{
  "name": "showrunner",
  "version": "1.0.0-beta1",
  "description": "Flutter desktop broadcaster automation app with an OBS browser overlay runtime.",
  "private": true,
  "type": "module",
  "scripts": {
    "setup-vite": "yarn workspace showrunner-vite build",
    "overlay:build": "yarn setup-vite && yarn workspace showrunner-obs-overlay build:test",
    "overlay:test": "vitest run",
    "parity:check": "node ./tools/parity/check.mjs",
    "parity:product": "node ./tools/parity/product/check.mjs",
    "visual:compare": "node ./tools/visual_parity/compare.mjs",
    "visual:flutter": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/capture-flutter-visual.ps1",
    "test:flutter-integration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-flutter-integration.ps1",
    "flutter:smoke-windows": "pwsh -NoProfile -File ./scripts/smoke-flutter-windows.ps1",
    "flutter:package-windows": "pwsh -NoProfile -File ./scripts/package-flutter-windows.ps1",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "workspaces": [
    "packages/showrunner-obs-overlay",
    "libs/showrunner-schema",
    "libs/showrunner-overlay-core",
    "libs/showrunner-overlay-widget-loader",
    "libs/showrunner-vite",
    "libs/showrunner-ws-rpc",
    "plugins/overlays/shared",
    "plugins/overlays/overlay",
    "plugins/random/overlay",
    "plugins/twitch/shared",
    "plugins/twitch/overlay"
  ],
  "author": "LordTocs",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "pinia": "^2.1.7",
    "semantic-release": "24",
    "typescript": "^5.1.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^2.3.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "yarn@4.1.0"
}
