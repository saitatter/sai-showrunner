{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ShowRunner Flutter",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/packages/showrunner-flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/packages/showrunner-flutter"
    },
    {
      "name": "ShowRunner Flutter smoke",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/packages/showrunner-flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/packages/showrunner-flutter",
      "args": ["--showrunner-smoke=startup"]
    }
  ]
}
